{
  "name": "agent-machi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && npm run typecheck:plugin",
    "typecheck:plugin": "tsc --noEmit --ignoreConfig --strict --target es2022 --module nodenext --moduleResolution nodenext --allowImportingTsExtensions --skipLibCheck plugins/opencode/index.ts plugins/opencode/delivery.ts plugins/opencode/reducer.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts plugins/opencode/*.test.ts",
    "bridge": "node tools/herdr-bridge/index.mjs",
    "bridge:fake": "FAKE=1 node tools/herdr-bridge/index.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
